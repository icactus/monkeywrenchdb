//Makes sure deMetriek is only saving integers when using P
function roundValuesInArray(obj) {
  for (var k in obj) {
      if (typeof obj[k] === 'object' && obj[k] !== null) {
          roundValuesInArray(obj[k]);
      } else if (typeof obj[k] === 'number') {
          obj[k] = Math.round(obj[k]);
      }
  }
}

