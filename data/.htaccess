# Static JSON data files — served directly by Apache
# Disable directory browsing
Options -Indexes

# Only allow requests from our own site (blocks direct visits and scraping)
RewriteEngine On
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?monkeywrenchdb\.org [NC]
RewriteRule \.json$ - [F,L]

SetEnvIf Request_URI "^/data/recordings/" mutable_recordings_json

# Caching and content type for .json files
<FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=!mutable_recordings_json
    Header set Cache-Control "public, max-age=300, s-maxage=31536000, stale-while-revalidate=86400" env=mutable_recordings_json
    Header set Content-Type "application/json; charset=utf-8"
</FilesMatch>

# Block access to all non-json files
<FilesMatch "^(?!.*\.json$)">
    Require all denied
</FilesMatch>
